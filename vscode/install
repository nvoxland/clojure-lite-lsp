#!/usr/bin/env bash
# Build, test and package the VS Code extension, then install it into VS Code.
#
#   vscode/install
#
# The server itself: bin/install-server. Needs Node.js (npm).
set -euo pipefail
cd "$(dirname "$0")"

npm ci --no-fund --no-audit
npm test
npm run package

code_cli="$(command -v code || command -v code-insiders || true)"
for app in "/Applications/Visual Studio Code.app" "$HOME/Applications/Visual Studio Code.app" \
           "/Applications/Visual Studio Code - Insiders.app"; do
  if [[ -z "$code_cli" && -x "$app/Contents/Resources/app/bin/code" ]]; then
    code_cli="$app/Contents/Resources/app/bin/code"
  fi
done
vsix="$(ls -t clojure-lite-lsp-*.vsix | head -1)"
if [[ -n "$code_cli" ]]; then
  "$code_cli" --install-extension "$vsix" --force
  echo "Installed $vsix. Reload VS Code's window to use it."
else
  echo "VS Code's 'code' command wasn't found: install $PWD/$vsix with 'Extensions: Install from VSIX...'."
fi
