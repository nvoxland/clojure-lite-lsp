#!/usr/bin/env bash
# Build the clojure-lite-lsp native binary into target/clojure-lite-lsp.
#
# Needs GraalVM (native-image) as JAVA_HOME or on the PATH.
# CLOJURE_LITE_LSP_MARCH picks the CPU target (default: native, the build machine's; on
# Apple silicon that is the M-series feature set). Portable builds can use
# e.g. armv8.1-a or x86-64-v2, at the cost of slower content hashing (no SHA
# instructions).
set -euo pipefail
cd "$(dirname "$0")/.."

# JAVA_HOME's native-image when it's a GraalVM, else the one on PATH
if [[ -n "${JAVA_HOME:-}" && -x "$JAVA_HOME/bin/native-image" ]]; then
  NATIVE_IMAGE="$JAVA_HOME/bin/native-image"
elif command -v native-image >/dev/null; then
  NATIVE_IMAGE="native-image"
else
  echo "native-image not found: set JAVA_HOME to a GraalVM, or put its native-image on PATH" >&2
  exit 1
fi
command -v clojure >/dev/null || { echo "the Clojure CLI (clojure) is needed to build: https://clojure.org/guides/install_clojure" >&2; exit 1; }

rm -rf classes && mkdir -p classes target
# clj-kondo's native config expects dynaload's AOT mode
clojure -J-Dborkdude.dynaload.aot=true -M:native -e "(compile 'clojure-lite-lsp.main)"

"$NATIVE_IMAGE" \
  -cp "$(clojure -Spath -A:native)" \
  --no-fallback \
  --features=clj_easy.graal_build_time.InitClojureClasses \
  --enable-native-access=ALL-UNNAMED \
  -H:+ReportExceptionStackTraces \
  -R:MaxHeapSize=64m \
  -march="${CLOJURE_LITE_LSP_MARCH:-native}" \
  -o target/clojure-lite-lsp \
  clojure_lite_lsp.main
