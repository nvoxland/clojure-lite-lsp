#!/usr/bin/env bash
# Build the clojure-lite-lsp native binary (if needed) and link it into
# ~/.local/bin, where the editor extensions (zed/, vscode/) find it on PATH.
#
#   bin/install-server            build if target/clojure-lite-lsp is missing, then link
#   bin/install-server --rebuild  always build first
#
# Building needs GraalVM: set JAVA_HOME to it, or have native-image on PATH.
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
bin_dir="${CLOJURE_LITE_LSP_BIN_DIR:-$HOME/.local/bin}"

case "${1:-}" in
  ""|--rebuild) ;;
  *) echo "Usage: bin/install-server [--rebuild]" >&2; exit 2 ;;
esac

if [[ "${1:-}" == "--rebuild" || ! -x "$repo/target/clojure-lite-lsp" ]]; then
  "$repo/bin/build-native"
fi

mkdir -p "$bin_dir"
ln -sf "$repo/target/clojure-lite-lsp" "$bin_dir/clojure-lite-lsp"
echo "Linked $bin_dir/clojure-lite-lsp -> $repo/target/clojure-lite-lsp ($("$bin_dir/clojure-lite-lsp" version))"

case ":$PATH:" in
  *":$bin_dir:"*) ;;
  *) echo "Note: $bin_dir is not on your PATH; add it, or set the path in your editor's settings" \
          "(Zed: lsp.clojure-lite-lsp.binary.path, VS Code: clojure-lite-lsp.path)." ;;
esac
